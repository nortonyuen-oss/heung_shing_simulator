{
  "name": "city-builder",
  "version": "5.11.0",
  "releaseTheme": "【香城洋紫荊勳章】",
  "description": "Hong Kong city builder for desktop and browsers, with local and portable city saves",
  "author": "The City of Heung Shing",
  "repository": {
    "type": "git",
    "url": "https://github.com/nortonyuen-oss/heung_shing_simulator.git"
  },
  "main": "electron-main.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "prepare:world-terrain": "node world/terrain-pack-builder.mjs",
    "test:world": "node --test test/world-streaming.test.js test/world-construction.test.js test/world-minimap.test.js test/world-simulation.test.js test/world-entry.test.js test/world-game-integration.test.js test/zoning-power.test.js",
    "smoke:world:integration": "node scripts/smoke-world-integration.js",
    "smoke:world:growth": "node scripts/smoke-world-growth.js",
    "profile:world": "node scripts/profile-world-integration.js",
    "profile:world:loading": "node scripts/profile-world-loading.js",
    "audit:world-coastline": "node scripts/audit-world-coastline.js",
    "smoke:world:geography": "node scripts/smoke-world-geography.js",
    "smoke:world": "node scripts/smoke-world-streaming.js",
    "smoke:world:construction": "node scripts/smoke-world-construction.js",
    "smoke:world:navigation": "node scripts/smoke-world-navigation.js",
    "smoke:world:simulation": "node scripts/smoke-world-simulation.js",
    "smoke:world:release": "node scripts/smoke-world-release.js",
    "start": "node server.js",
    "dev": "node server.js",
    "electron:dev": "node scripts/run-electron.js",
    "electron:perf": "npm run prepare:release-assets && node scripts/run-electron.js --performance",
    "rebuild:electron": "electron-builder install-app-deps",
    "prepare:release-assets": "node scripts/prepare-release-assets.js && node scripts/bake-night-textures.js && node scripts/bake-road-line-textures.js && node scripts/world-release-assets.js --ensure",
    "verify:world-assets": "node scripts/world-release-assets.js",
    "verify:release-assets": "node scripts/verify-release-assets.js",
    "dist": "npm run prepare:release-assets && npm run verify:release-assets && electron-builder",
    "dist:mac": "npm run prepare:release-assets && npm run verify:release-assets && electron-builder --mac",
    "dist:win": "npm run prepare:release-assets && npm run verify:release-assets && electron-builder --win",
    "generate:icons": "node scripts/generate-icons.js",
    "migrate:pg-to-sqlite": "node scripts/migrate-pg-to-sqlite.js",
    "optimize:assets": "node scripts/optimize-model-assets.js",
    "defringe:assets": "node scripts/defringe-model-assets.js",
    "audit:building-footprints": "node scripts/audit-building-footprints.js",
    "sync:hko-astronomy": "node scripts/sync-hko-astronomy-data.js",
    "bake:night-textures": "node scripts/bake-night-textures.js",
    "bake:road-line-textures": "node scripts/bake-road-line-textures.js",
    "bake:typhoon-shelter": "node scripts/bake-typhoon-shelter-textures.js",
    "bake:festivals": "node scripts/bake-festival-textures.js",
    "sync:lunar-calendar": "node scripts/sync-lunar-calendar.js",
    "audit:licenses": "node scripts/audit-licenses.js",
    "sync:legal": "node scripts/sync-legal-docs.js",
    "check:legal": "node scripts/sync-legal-docs.js --check",
    "build:web": "node scripts/build-web.js",
    "verify:web": "node scripts/verify-web-build.js",
    "preview:web": "node scripts/static-web-server.js",
    "test:web": "node scripts/smoke-web.js",
    "package:mac": "npm run verify:release-assets && electron-builder --mac",
    "package:win": "npm run verify:release-assets && electron-builder --win"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "express": "^4.18.2",
    "phaser": "3.60.0"
  },
  "devDependencies": {
    "electron": "^39.8.10",
    "electron-builder": "^26.8.1",
    "fake-indexeddb": "6.2.8",
    "playwright-core": "1.62.0",
    "sharp": "^0.34.5",
    "wrangler": "4.131.2"
  },
  "build": {
    "appId": "com.heungshing.citybuilder",
    "productName": "The City of Heung Shing",
    "publish": [
      {
        "provider": "github",
        "owner": "nortonyuen-oss",
        "repo": "heung_shing_simulator"
      }
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "**/*",
      "UI/news/**/*.webp",
      "!UI/news/**/*.png",
      "!release/**",
      "!docs/**",
      "!test/**",
      "!test-results/**",
      "!scripts/**",
      "!services/**",
      "!Models/**",
      "!.data/**",
      "!.git/**",
      "!.vscode/**",
      "!.claude/**",
      "!.codex/**",
      "!.agents/**",
      "!.aws/**",
      "!.env*",
      "!.venv/**",
      "!.DS_Store",
      "!data/world-terrain.building-*/**",
      "!**/.DS_Store",
      "!**/process_log.csv",
      "!**/settings.json",
      {
        "from": ".data/package-assets/Models",
        "to": "Models",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.games",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "license": "SEE LICENSE IN LICENSE",
  "releaseThemes": {
    "zh-HK": "【香城洋紫荊勳章】",
    "zh-TW": "【香城洋紫荊勳章】",
    "en": "【Heung Shing Bauhinia Medals】",
    "ja": "【香城洋紫荊勲章】"
  }
}
