{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "heung-shing-statistics",
  "account_id": "a6d7368702ab8725c1e8188b30da7edd",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-09",
  "workers_dev": true,
  "vars": {
    "READ_ORIGINS": "https://nortonyuen-oss.github.io",
    "PLAY_ORIGINS": "https://heung-shing-play.nortonyuen.workers.dev",
    "GAME_VERSIONS": "5.5.0"
  },
  "triggers": { "crons": ["0 */6 * * *"] },
  "d1_databases": [{ "binding": "DB", "database_name": "heung-shing-statistics", "database_id": "fb64970f-e88e-434f-9fff-f9471a4468ac", "migrations_dir": "migrations" }],
  "ratelimits": [{ "name": "PLAY_LIMIT", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } }]
}
